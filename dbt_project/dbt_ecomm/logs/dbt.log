  create  table "e-comm"."dev_schema"."sl_ecommerce_sales__dbt_tmp"
  
  
    as
  
  (
    

with cleaned as (
    SELECT
    transaction_id,
    cast(order_date as date) as order_date,
    customer_id,
    customer_name,
    case
    when country in ('US','UK','IN','DE','FR','CA','AU') THEN country
    else 'Unknown'
    end as country,
    product_id,
    product_category,
    case
        when quantity> 0 then quantity
        else 1
    end as quantity,
    case 
        when price>0 then price
        else 0
     end as price,
     order_status

  FROM "e-comm"."dev_schema"."br_ecommerce_sales"      
  WHERE customer_id is not null
      and cast(order_date as date)<= current_date

),

deduplicated as (
    select *,
        row_number() over (partition by transaction_id order by order_date desc) as rn
     from cleaned   
)

select * 
from deduplicated
where rn=1
  );
  
